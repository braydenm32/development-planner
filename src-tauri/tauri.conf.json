{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Contour and Gable",
  "mainBinaryName": "contour-and-gable",
  "version": "0.5.0",
  "identifier": "com.contourandgable.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Contour & Gable",
        "width": 1440,
        "height": 920,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Contour and Gable",
    "category": "Productivity",
    "shortDescription": "Plan a house on a contour survey",
    "longDescription": "Plan a house on its block from the contour survey, check it, cost it and print it, with projects saved straight into a folder and prints sent straight to your slicer.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
